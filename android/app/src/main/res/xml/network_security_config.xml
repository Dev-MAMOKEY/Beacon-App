<?xml version="1.0" encoding="utf-8"?>
<!--
  백엔드가 아직 평문 HTTP(http://43.203.209.87:8081)로만 서비스된다. Android 9
  (API 28)부터 cleartext는 기본 차단이라, 이 설정이 없으면 릴리스 빌드에서 모든
  요청이 실패한다.

  `android:usesCleartextTraffic="true"` 로 전역을 여는 대신 이 호스트 하나만
  예외로 둔다 — 전역 옵트인은 앱이 앞으로 붙을 모든 호스트(써드파티 SDK 포함)에
  대해서까지 평문을 허용하므로 필요 이상으로 큰 구멍이다.

  서버가 HTTPS로 전환되면 이 파일과 매니페스트의 networkSecurityConfig 속성,
  그리고 iOS의 NSAppTransportSecurity 예외를 함께 지운다.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">43.203.209.87</domain>
    </domain-config>
</network-security-config>
